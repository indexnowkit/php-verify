<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone configuration for the split repository (indexnowkit/php-verify); the monorepo CI runs it per package. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php" colors="true" failOnWarning="true" cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="verify"><directory>tests</directory></testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
